# MySQL configuration
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_DATABASE=secondlight
MYSQL_USER=secondlight
MYSQL_PASSWORD=secondlightpass
MYSQL_PORT=3306

# Application configuration
DB_URL=jdbc:mysql://mysql:3306/secondlight?useUnicode=true&characterEncoding=utf8&serverTimezone=UTC
DB_USERNAME=secondlight
DB_PASSWORD=secondlightpass
APP_PORT=8080
USER_SERVICE_PORT=18093
ITEM_SERVICE_PORT=18091
ORDER_SERVICE_PORT=18092

# Nacos 3.2.4（首次启动 Nacos 前设置；请替换为本地随机值）
NACOS_AUTH_TOKEN=replace-with-a-base64-token-at-least-32-characters
NACOS_AUTH_IDENTITY_KEY=replace-with-local-identity-key
NACOS_AUTH_IDENTITY_VALUE=replace-with-local-identity-value
NACOS_CONSOLE_PORT=18081
NACOS_SERVER_PORT=18848
NACOS_CLIENT_PORT=19848

# Nacos 初始化管理员改密后，填入业务服务使用的账号密码
NACOS_USERNAME=nacos
NACOS_PASSWORD=replace-after-changing-nacos-admin-password
NACOS_GROUP=DEFAULT_GROUP
